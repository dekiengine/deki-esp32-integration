{
  "id": "deki-esp32-integration",
  "displayName": "ESP32 Integration",
  "minEngine": "0.16.0",
  "buildDefine": "DEKI_PACKAGE_ESP32_HAL",
  "requires": [
    "deki-wifi",
    "deki-ble",
    "deki-http",
    "deki-i2s",
    "deki-uart",
    "deki-i2c",
    "deki-gpio",
    "deki-sdcard",
    "deki-rendering"
  ],
  "features": [
    {
      "id": "memory",
      "displayName": "Memory",
      "buildDefine": "DEKI_FEATURE_ESP32_MEMORY_SETUP",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "filesystem",
      "displayName": "File System",
      "buildDefine": "DEKI_FEATURE_ESP32_FILE_SYSTEM_SETUP",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "serial",
      "displayName": "Serial Commands",
      "buildDefine": "DEKI_FEATURE_ESP32_SERIAL_SETUP",
      "defaultEnabled": true,
      "componentTypes": [
        "ESP32SerialSetup"
      ]
    },
    {
      "id": "sd",
      "displayName": "SD Card (ESP-IDF)",
      "buildDefine": "DEKI_FEATURE_ESP32_SD",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "gpio",
      "displayName": "GPIO (ESP-IDF)",
      "buildDefine": "DEKI_FEATURE_ESP32_GPIO",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "i2c",
      "displayName": "I²C (ESP-IDF)",
      "buildDefine": "DEKI_FEATURE_ESP32_I2C",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "uart",
      "displayName": "UART (ESP-IDF)",
      "buildDefine": "DEKI_FEATURE_ESP32_UART",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "i2s",
      "displayName": "I²S (ESP-IDF)",
      "buildDefine": "DEKI_FEATURE_ESP32_I2S",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "blit_simd",
      "displayName": "S3 SIMD Blit Kernels",
      "buildDefine": "DEKI_FEATURE_ESP32_BLIT_SIMD",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "wifi",
      "displayName": "WiFi STA + scan (ESP-IDF)",
      "buildDefine": "DEKI_FEATURE_ESP32_WIFI",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "ble",
      "displayName": "BLE (NimBLE)",
      "buildDefine": "DEKI_FEATURE_ESP32_BLE",
      "defaultEnabled": true,
      "componentTypes": []
    },
    {
      "id": "http",
      "displayName": "HTTPS client (ESP-IDF)",
      "buildDefine": "DEKI_FEATURE_ESP32_HTTP",
      "defaultEnabled": true,
      "componentTypes": []
    }
  ],
  "dependencies": {
    "espidf": [
      "fatfs",
      "sdmmc",
      "esp_driver_gpio",
      "esp_driver_uart",
      "esp_driver_i2c",
      "esp_driver_i2s",
      "esp_driver_spi",
      "esp_driver_sdmmc",
      "esp_driver_sdspi",
      "esp_wifi",
      "esp_http_client",
      "esp-tls",
      "mbedtls",
      "nvs_flash",
      "bt"
    ]
  }
}
